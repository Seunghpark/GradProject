# Server only. Never put this value in VITE_ variables or frontend files.
# Get a development key from https://developer.riotgames.com/
RIOT_API_KEY=
# Optional YouTube Data API v3 key for video results (search links need no key).
YOUTUBE_API_KEY=
# Optional absolute JSON artifact path:
# MODEL_PATH=C:/path/to/model.json
# Automatic shared collection uses backend/data/match_store.sqlite3 by default.
# MATCH_STORE_PATH=C:/path/to/match_store.sqlite3
# Optional original JSONL seed; it is read without modifying it.
# MATCH_SEED_PATH=C:/path/to/riot_matches.jsonl
